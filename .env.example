# ==============================================================
# VIGO AI ADMINISTRATION — DEMO GRATUITA v1.0
# CHESS AI AGENCY · Plantilla de variables de entorno
# Copia este archivo como ".env.local" y sustituye los valores.
# NUNCA subas secretos reales a GitHub (el .gitignore ya los excluye).
# ==============================================================

# --- SUPABASE (opcional en demo: si falta, la app funciona sin persistencia) ---
# https://supabase.com/dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO_SUPABASE.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_CLAVE_ANON_PUBLIC_AQUI
# Key service_role — SOLO SERVIDOR. Usada para auditoría y panel admin.
# Supabase la genera en Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=TU_CLAVE_SERVICE_ROLE_AQUI

# --- OPENROUTER (modelos free) ---
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-TU_CLAVE_OPENROUTER_AQUI
# Modelo principal gratuito. Alternativas ":free" en https://openrouter.ai/models
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Modelo de respaldo (se usa si el principal falla o agota cuota)
OPENROUTER_FALLBACK_MODEL=google/gemma-3-27b-it:free

# --- GROQ (fallback rápido · inferencia LPU) ---
# https://console.groq.com/keys — sin tarjeta. 30 RPM · 1.000 req/día · 200K tokens/día
GROQ_API_KEY=TU_CLAVE_GROQ_AQUI
GROQ_MODEL=openai/gpt-oss-120b

# --- COHERE (1.000 llamadas/mes free, buen gl/es/en) ---
# https://dashboard.cohere.com/api-keys — clave "Trial" sin tarjeta. USO NO COMERCIAL en Trial.
COHERE_API_KEY=TU_CLAVE_COHERE_AQUI
COHERE_MODEL=command-r7b-12-2024

# --- CLOUDFLARE WORKERS AI (10.000 "neurons"/día free) ---
# https://dash.cloudflare.com/profile/api-tokens (token con permiso Workers AI)
# El Account ID está en el panel de Cloudflare → Workers & Pages (derecha)
CLOUDFLARE_API_KEY=TU_TOKEN_CLOUDFLARE_AQUI
CLOUDFLARE_ACCOUNT_ID=TU_ACCOUNT_ID_CLOUDFLARE_AQUI
CLOUDFLARE_MODEL=@cf/openai/gpt-oss-120b

# --- OVHCLOUD AI ENDPOINTS (anónimo, hosting UE, 2 RPM/IP) ---
# Sin clave ni registro. Útil como último recurso con soberanía de datos (RGPD).
OVHAI_MODEL=Meta-Llama-3_3-70B-Instruct

# --- GOOGLE GEMINI (fallback directo vía Google AI Studio) ---
# https://aistudio.google.com/apikey — nivel gratuito disponible
GEMINI_API_KEY=AIzaTU_CLAVE_GEMINI_AQUI
GEMINI_MODEL=gemini-2.0-flash

# --- PANEL DE ADMINISTRACIÓN ---
# Token simple para acceder a /admin en la demo (elige uno aleatorio y largo)
ADMIN_TOKEN=TU_TOKEN_ADMIN_LARGO_Y_ALTO_AQUI

# --- CONFIGURACIÓN DEMO ---
# La demo usa documentos sintéticos. No conectar a sistemas municipales reales.
NEXT_PUBLIC_DEMO_MODE=true

# --- SEDE ELECTR�NICA (integraci�n real - Semana 4 v1.2) ---
# Modo: mock (default, simulado) | real (requiere credenciales del Concello)
SEDE_ELECTRONICA_MODE=mock
# URL base del sandbox de la Sede Electr�nica (solo si mode=real)
SEDE_ELECTRONICA_BASE_URL=https://sede.vigo.org/sandbox
# Token de acceso al sandbox (solo si mode=real)
SEDE_ELECTRONICA_TOKEN=TU_TOKEN_SEDE_ELECTRONICA_AQUI

# --- OBSERVABILIDAD (opcional) ---
# Langfuse (trazas en cloud). Si no se configura, se persisten en Supabase.
LANGFUSE_PUBLIC_KEY=pk-lf-TU_CLAVE_PUBLICA
LANGFUSE_SECRET_KEY=sk-lf-TU_CLAVE_SECRETA
LANGFUSE_HOST=https://cloud.langfuse.com

# --- RETENCION DE DATOS (GDPR/ENS - Semana 4 v1.2) ---
# TTL en dias para conversaciones y audit_events (default: 90)
DATA_RETENTION_DAYS=90
